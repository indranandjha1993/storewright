{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "48rem", "wideSize": "80rem" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#FAFAF7" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Contrast", "color": "#15171A" },
				{ "slug": "muted", "name": "Muted", "color": "#5F6368" },
				{ "slug": "line", "name": "Line", "color": "#E6E4DF" },
				{ "slug": "accent", "name": "Accent", "color": "#0F5C4D" },
				{ "slug": "accent-hover", "name": "Accent hover", "color": "#0D5144" },
				{ "slug": "accent-soft", "name": "Accent soft", "color": "#DAE4E0" },
				{ "slug": "on-accent", "name": "On accent", "color": "#FFFFFF" },
				{ "slug": "sale", "name": "Sale", "color": "#B4472B" },
				{ "slug": "on-sale", "name": "On sale", "color": "#FFFFFF" }
			]
		},
		"custom": {
			"radius": "10px",
			"radiusSmall": "8px",
			"radiusButton": "10px",
			"shadow": "0 1px 2px rgb(21 23 26 / 6%), 0 8px 24px rgb(21 23 26 / 6%)"
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{ "slug": "sans", "name": "Body", "fontFamily": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif" },
				{ "slug": "heading", "name": "Headings", "fontFamily": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif" },
				{ "slug": "mono", "name": "Mono", "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3.5rem" } },
				{ "slug": "xxx-large", "name": "Hero", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4.75rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "1rem" },
				{ "slug": "30", "name": "3", "size": "1.5rem" },
				{ "slug": "40", "name": "4", "size": "2rem" },
				{ "slug": "50", "name": "5", "size": "3rem" },
				{ "slug": "60", "name": "6", "size": "4.5rem" },
				{ "slug": "70", "name": "7", "size": "6rem" }
			],
			"units": [ "px", "rem", "em", "%", "vw" ]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [ { "slug": "card", "name": "Card", "shadow": "0 1px 2px rgb(21 23 26 / 6%), 0 8px 24px rgb(21 23 26 / 6%)" } ]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"css": "-webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;",
		"spacing": {
			"padding": { "left": "var(--wp--preset--spacing--20)", "right": "var(--wp--preset--spacing--20)" },
			"blockGap": "var(--wp--preset--spacing--30)"
		},
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--accent)" }, ":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } } },
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.1", "letterSpacing": "-0.01em" } },
			"caption": { "color": { "text": "var(--wp--preset--color--muted)" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--accent)", "text": "var(--wp--preset--color--on-accent)" },
				"border": { "radius": "var(--wp--custom--radius-button)", "width": "0" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600" },
				":hover": { "color": { "background": "var(--wp--preset--color--accent-hover)", "text": "var(--wp--preset--color--on-accent)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--accent-hover)", "text": "var(--wp--preset--color--on-accent)" } }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--large)" } },
			"core/navigation": { "typography": { "fontWeight": "500" } },
			"core/post-title": { "typography": { "fontWeight": "600" } },
			"woocommerce/product-price": { "typography": { "fontWeight": "600" } },
			"woocommerce/product-sale-badge": { "color": { "background": "var(--wp--preset--color--sale)", "text": "var(--wp--preset--color--on-sale)" } },
			"woocommerce/breadcrumbs": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "color": { "text": "var(--wp--preset--color--muted)" } },
			"core/paragraph": { "color": { "text": "var(--wp--preset--color--contrast)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "checkout-header", "title": "Checkout header", "area": "header" }
	],
	"customTemplates": []
}
