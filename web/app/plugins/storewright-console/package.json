{
  "name": "storewright-console",
  "version": "0.4.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-build",
    "dev": "wp-build --watch"
  },
  "wpPlugin": {
    "name": "storewright_console",
    "scriptGlobal": false,
    "packageNamespace": "storewright-console",
    "handlePrefix": "storewright-console",
    "pages": [
      {
        "id": "storewright",
        "capability": "manage_woocommerce",
        "init": [
          "@storewright-console/console-init"
        ]
      }
    ]
  },
  "devDependencies": {
    "@wordpress/api-fetch": "7.57.0",
    "@wordpress/boot": "0.24.0",
    "@wordpress/build": "0.25.0",
    "@wordpress/components": "42.0.0",
    "@wordpress/data": "10.57.0",
    "@wordpress/element": "9.0.0",
    "@wordpress/i18n": "6.30.0",
    "@wordpress/icons": "18.0.0",
    "@wordpress/route": "0.23.0",
    "@wordpress/url": "4.57.0"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
