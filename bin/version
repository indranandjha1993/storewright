#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
version="${1:?usage: bin/version x.y.z}"

sed -i.bak -E "s/^( \* Version: ).*/\1$version/" web/app/plugins/storewright-core/storewright-core.php web/app/plugins/storewright-console/storewright-console.php
sed -i.bak -E "s/^(Version: ).*/\1$version/" web/app/themes/storewright/style.css
sed -i.bak -E "s/^(const VERSION = ').*(';)/\1$version\2/" web/app/mu-plugins/storewright-platform/plugin.php web/app/plugins/storewright-core/storewright-core.php
sed -i.bak -E "s/^(  \"version\": \").*(\",)/\1$version\2/" web/app/plugins/storewright-console/package.json
sed -i.bak -E "s/^(Version )[0-9.]+\./\1$version./" README.md
find web -name "*.bak" -delete
rm -f README.md.bak
npm install --package-lock-only --no-audit --no-fund >/dev/null 2>&1
echo "version $version written"
