#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."

: "${WP_HOME:?}" "${ADMIN_USER:?}" "${ADMIN_EMAIL:?}" "${ADMIN_PASSWORD:?}"
title="${SITE_TITLE:-Storewright}"

for _ in $(seq 1 45); do
  wp db check >/dev/null 2>&1 && break
  sleep 2
done
wp db check >/dev/null

# On a server the app container fills the plugins volume as it starts; wait for that copy to land.
for _ in $(seq 1 60); do
  [ -f web/app/plugins/woocommerce/woocommerce.php ] && [ ! -d web/app/plugins/.sync-lock ] && break
  sleep 2
done

if ! wp core is-installed >/dev/null 2>&1; then
  wp core install --url="$WP_HOME" --title="$title" --admin_user="$ADMIN_USER" \
    --admin_email="$ADMIN_EMAIL" --admin_password="$ADMIN_PASSWORD" --skip-email
fi

wp plugin activate woocommerce woo-razorpay storewright-core
wp theme activate storewright
wp rewrite structure '/%postname%/' --hard
wp wc hpos enable
wp storewright setup
wp cron event run --due-now >/dev/null 2>&1 || true

echo "installed: $WP_HOME  admin user: $ADMIN_USER"
