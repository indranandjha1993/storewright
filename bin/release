#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
version="${1:?usage: bin/release x.y.z}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "version must look like 1.2.3" >&2; exit 1; }
[ "$(git branch --show-current)" = main ] || { echo "release from main" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "commit or stash your changes first" >&2; exit 1; }
git fetch -q origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is not in step with origin; pull or push first" >&2; exit 1; }
[ -z "$(git tag -l "v$version")" ] || { echo "v$version already exists" >&2; exit 1; }
grep -q '^## Unreleased$' CHANGELOG.md || { echo "CHANGELOG.md needs an Unreleased section" >&2; exit 1; }
awk '/^## Unreleased$/ {on=1; next} on && /^## / {exit} on && NF {found=1} END {exit !found}' CHANGELOG.md || { echo "nothing under Unreleased in CHANGELOG.md" >&2; exit 1; }
run="$(gh run list --branch main --workflow ci --commit "$(git rev-parse HEAD)" --limit 1 --json conclusion --jq '.[0].conclusion' 2>/dev/null || true)"
[ "$run" = success ] || { echo "ci is not green on this commit (${run:-no run}); wait for it or fix it" >&2; exit 1; }

bin/version "$version"
awk -v h="## $version - $(date +%F)" '/^## Unreleased$/ {print; print ""; print h; next} {print}' CHANGELOG.md > CHANGELOG.md.new
mv CHANGELOG.md.new CHANGELOG.md
git add -A
git commit -q -m "release $version"
git tag -a "v$version" -m "$version"
git push -q origin main "v$version"
echo "v$version pushed; the pipeline tests, builds, scans, publishes and deploys it"
