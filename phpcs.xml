<?xml version="1.0"?>
<ruleset name="Storewright">
	<file>web/app/plugins/storewright-core</file>
	<file>web/app/plugins/storewright-console/storewright-console.php</file>
	<file>web/app/plugins/storewright-console/src</file>
	<file>web/app/mu-plugins/storewright-platform</file>
	<file>web/app/mu-plugins/storewright-platform.php</file>
	<file>web/app/themes/storewright</file>
	<file>tests</file>
	<exclude-pattern>*/build/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="testVersion" value="8.3-"/>
	<config name="minimum_wp_version" value="7.0"/>
	<rule ref="WordPress-Extra">
		<exclude name="Generic.Commenting"/>
		<exclude name="Squiz.Commenting"/>
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>*/Seed/*</exclude-pattern>
		<exclude-pattern>*/Cli/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions.error_log_set_error_handler">
		<exclude-pattern>*/storewright-platform/src/Health.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.runtime_configuration_putenv">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="storewright"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="storewright"/><element value="Storewright"/></property>
		</properties>
	</rule>
</ruleset>
