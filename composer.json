{
  "name": "indranandjha1993/storewright",
  "description": "Online store platform on WordPress and WooCommerce",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3",
    "oscarotero/env": "^2.1",
    "roots/wordpress": "7.1.3",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.6",
    "wp-plugin/woocommerce": "11.2.1",
    "wp-plugin/woo-razorpay": "4.8.8"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "autoload-dev": {
    "psr-4": {
      "Storewright\\Platform\\": "web/app/mu-plugins/storewright-platform/src/",
      "Storewright\\Core\\": "web/app/plugins/storewright-core/src/",
      "Storewright\\Console\\": "web/app/plugins/storewright-console/src/",
      "Storewright\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/woocommerce-stubs": "*",
    "php-stubs/wp-cli-stubs": "^2.11",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  }
}
