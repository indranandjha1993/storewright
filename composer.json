{
  "name": "indranandjha1993/storewright",
  "description": "Online store platform on WordPress and WooCommerce",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3",
    "oscarotero/env": "^2.1",
    "roots/wordpress": "7.1.3",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.6",
    "wp-plugin/woocommerce": "11.2.1",
    "wp-plugin/woocommerce-gateway-stripe": "11.0.1",
    "wp-plugin/woo-razorpay": "4.8.8",
    "wp-theme/twentytwentyfive": "1.3"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "web/wp"
  }
}
