# Copy to .env with ./deploy.sh init, then fill in the store's values.
STORE_NAME=storewright-store
STOREWRIGHT_IMAGE=ghcr.io/indranandjha1993/storewright

WP_ENV=production
DOMAIN=shop.example.com
WP_HOME=https://shop.example.com
WP_SITEURL=${WP_HOME}/wp
LOGIN_PATH=sign-in
SITE_TITLE=Storewright

# Where nginx listens. Leave on loopback behind Caddy or a tunnel; COMPOSE_PROFILES=caddy adds
# Caddy on ports 80 and 443 with certificates for DOMAIN.
WEB_BIND=127.0.0.1:8080
COMPOSE_PROFILES=caddy

DB_NAME=storewright
DB_USER=storewright
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=db
REDIS_HOST=cache

ADMIN_USER=admin
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

MAIL_HOST=
MAIL_SMTP_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

BACKUP_KEEP=14

AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
